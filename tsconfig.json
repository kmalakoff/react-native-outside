{
  "extends": "tsds-config/tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "strict": true,
    "lib": ["es2015", "dom"],
    "jsx": "react",
    "types": ["mocha", "node"],
    "moduleResolution": "bundler",
    "customConditions": ["react-native-legacy-deep-imports"]
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist", "test/data", "test/native", "test/browser", "test/types/profiles"]
}
