{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": false,
    "lib": ["es2022"],
    "target": "es2015",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["react", "react-native"],
    "noEmit": true,
    "customConditions": ["react-native-legacy-deep-imports"],
    "jsx": "react"
  },
  "include": ["src"]
}
