{
  "name": "react-native-outside",
  "version": "1.0.14",
  "description": "React components for react-native click outside",
  "keywords": [
    "react",
    "native",
    "react-native",
    "web",
    "contains",
    "outside",
    "universal",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmalakoff/react-native-outside.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff@gmail.com> (https://github.com/kmalakoff)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsds build",
    "docs": "tsds docs",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "npm run test:types && npm run test:browser && npm run test:node",
    "test:browser": "npm run test:browser:minimum && npm run test:browser:current",
    "test:browser:checkpoints": "node test/lib/browser-checkpoints.mjs",
    "test:browser:current": "npm ci --prefix test/browser/current --ignore-scripts --no-audit --no-fund && tsds test:browser --config wtr.current.config.mjs test/exports/import.test.ts test/exports/import.test.mjs test/unit/native-web.test.tsx",
    "test:browser:minimum": "npm ci --prefix test/browser/minimum --ignore-scripts --no-audit --no-fund && tsds test:browser --config wtr.minimum.config.mjs test/exports/import.test.ts test/exports/import.test.mjs test/unit/native-web.test.tsx",
    "test:engines": "npm run build && node test/lib/test-floor.ts",
    "test:node": "tsds test:node --no-timeouts test/unit/lib/nativeTarget.test.ts test/exports/require.test.cjs",
    "test:types": "npm run build && node test/types/run.ts",
    "test:types:generated": "npm run build && node test/types/run.ts --generated",
    "version": "tsds version"
  },
  "devDependencies": {
    "@types/mocha": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@types/semver": "^7.8.0",
    "@web/dev-server-import-maps": "^0.3.0",
    "assert": "^1.5.1",
    "esbuild": "^0.28.2",
    "fs-remove-compat": "^1.0.0",
    "node-version-use": "*",
    "react": "*",
    "react-dom": "*",
    "react-native": "*",
    "react-native-contains": "^1.0.12",
    "react-native-event": "^1.0.10",
    "react-ref-boundary": "^1.0.9",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "ts-dev-stack": "*",
    "tsds-config": "*",
    "tsds-web-test-runner": "*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.82.1",
    "react-native-contains": "^1.0.8",
    "react-native-event": "^1.0.7",
    "react-ref-boundary": "^1.0.7"
  },
  "engines": {
    "node": ">=16"
  },
  "allowScripts": {
    "esbuild": true
  }
}
